@model AcxiomCRM.Web.Models.Activity

@{
    ViewData["Title"] = "Delete Activity";
}

<div class="container px-4 py-4">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow border-0 rounded-4 border-danger">
                <div class="card-body p-4 p-sm-5 text-center">
                    <h2 class="fw-bold text-danger mb-3">Delete Activity</h2>
                    <p class="text-muted">Are you sure you want to delete this activity record?</p>

                    <div class="card bg-light border-0 p-3 text-start mb-4">
                        <p class="mb-1"><strong>Subject:</strong> @Model.Subject</p>
                        <p class="mb-1"><strong>Type:</strong> @Model.ActivityType</p>
                        <p class="mb-0"><strong>Due:</strong> @Model.DueDate.ToString("MMM dd, yyyy HH:mm")</p>
                    </div>

                    <form asp-action="Delete">
                        <input type="hidden" asp-for="ActivityId" />
                        <div class="d-flex justify-content-between">
                            <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">Cancel</a>
                            <button type="submit" class="btn btn-danger rounded-pill px-4">Yes, Delete</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
