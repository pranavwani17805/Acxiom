@model AcxiomCRM.Web.Models.Customer

@{
    ViewData["Title"] = "Delete Customer";
}

<div class="container px-4 py-4">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow border-0 rounded-4 border-danger">
                <div class="card-body p-4 p-sm-5 text-center">
                    <h2 class="fw-bold text-danger mb-3">Delete Customer</h2>
                    <p class="text-muted">Are you sure you want to delete this customer? This action cannot be undone.</p>

                    <div class="card bg-light border-0 p-3 text-start mb-4">
                        <p class="mb-1"><strong>Name:</strong> @Model.CustomerName</p>
                        <p class="mb-1"><strong>Company:</strong> @Model.CompanyName</p>
                        <p class="mb-0"><strong>Email:</strong> @Model.Email</p>
                    </div>

                    <form asp-action="Delete">
                        <input type="hidden" asp-for="CustomerId" />
                        <div class="d-flex justify-content-between">
                            <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">Cancel</a>
                            <button type="submit" class="btn btn-danger rounded-pill px-4">Yes, Delete</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
